# ProPar Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (optional for prompt analysis)
# Leave empty if you are only running the AI analysis API.
# Example: mongodb://localhost:27017/propar
MONGODB_URI=

# Google AI Studio Gemini Provider
# Keep this key server-side in backend .env only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Legacy OpenRouter settings are optional and not used by the default provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODELS=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_COMPLETION_TOKENS=3500

# CORS Configuration (optional, for production)
# Comma-separated list of allowed origins
# Example: https://propaar.netlify.app
ALLOWED_ORIGINS=
