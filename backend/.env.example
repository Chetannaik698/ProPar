# ProPar Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (optional for prompt analysis)
# Leave empty if you are only running the AI analysis API.
# Example: mongodb://localhost:27017/propar
MONGODB_URI=

# OpenRouter Provider
# Use an OpenRouter model id. Gemini through OpenRouter is the default target.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional comma-separated fallback models. Used only after genuine provider/model failures.
OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-001
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_COMPLETION_TOKENS=3500

# CORS Configuration (optional, for production)
# Comma-separated list of allowed origins
# Example: https://propaar.netlify.app
ALLOWED_ORIGINS=